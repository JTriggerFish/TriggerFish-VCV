{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "VCV: build plugin",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\dev.ps1",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "VCV: install plugin",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\dev.ps1",
                "install"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "VCV: install and run Rack",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\dev.ps1",
                "run"
            ],
            "problemMatcher": "$gcc"
        },
		{
			"label": "VCV: run Slop4 smoke patch",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\dev.ps1",
				"smoke-slop4"
			],
			"problemMatcher": "$gcc"
		},
		{
			"label": "VCV: run VDPO smoke patch",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\dev.ps1",
				"smoke-vdpo"
			],
			"problemMatcher": "$gcc"
		},
		{
			"label": "VCV: C++ DSP tests",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\dev.ps1",
				"test"
			],
			"group": "test",
			"problemMatcher": "$gcc"
		},
		{
			"label": "VCV: Python DSP tests",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\dev.ps1",
				"python-test"
			],
			"group": "test",
			"problemMatcher": "$gcc"
		},
		{
            "label": "VCV: package plugin",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\dev.ps1",
                "dist"
            ],
            "problemMatcher": "$gcc"
        }
    ]
}
