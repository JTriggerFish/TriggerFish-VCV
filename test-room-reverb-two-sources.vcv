      ]
    },
    {
      "id": 3,
      "plugin": "TriggerFish-Elements",
      "model": "TfProgSequencer",
      "version": "2.4.0",
      "params": [],
      "data": {
        "source": "bass = sequence {\n  subdiv 2\n  tonic D@1\n  scale dorian\n  notes 1_2 7_2 4_2 5 7\n  gate .96\n}\n\nplay bass\n",
        "languageVersion": 1
      },
      "pos": [
        25,
        0
      ]
    },
    {
      "id": 4,
      "plugin": "TriggerFish-Elements",
      "model": "TfProgSequencer",
      "version": "2.4.0",
      "params": [],
      "data": {
        "source": "arpeggio = sequence {\n  subdiv 16\n  tonic D@4\n  scale dorian\n  notes 3' 1' 5 3 ; 1' 5 3 1 ; 2' 7 5 2 ; 7 5 2 1\n  gate .52\n  cv1 4 -4 |> interp linear |> rate 1/9\n}\n\nplay arpeggio\n",
        "languageVersion": 1,
        "editorHeatmap": 5
      },
      "pos": [
        55,
        0
      ]
    },
