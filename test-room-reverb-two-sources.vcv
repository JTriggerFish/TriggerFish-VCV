    {
      "id": 3,
      "plugin": "TriggerFish-Elements",
      "model": "TfProgSequencer",
      "version": "2.5.3",
      "params": [],
      "data": {
        "source": "bass = sequence {\n  subdiv 2n\n  tonic D@1\n  scale dorian\n  notes 1_2 7_2 4_2 5 7\n  gate .96\n}\n\nplay bass\n",
