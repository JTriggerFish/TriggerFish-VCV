    {
      "id": 4,
      "plugin": "TriggerFish-Elements",
      "model": "TfProgSequencer",
      "version": "2.5.3",
      "params": [],
      "data": {
        "source": "arpeggio = sequence {\n  subdiv 16n\n  tonic D@4\n  scale dorian\n  notes 3' 1' 5 3 ; 1' 5 3 1 ; 2' 7 5 2 ; 7 5 2 1\n  gate .52\n  cv1 2 -2 |> interp linear |> rate 1/9\n  cv2 env ad 5ms 16n depth 2 curve 0\n}\n\nplay arpeggio\n",
        "languageVersion": 1,
        "editorHeatmap": 5
      },
      "pos": [
        42,
        0
      ]
    },
    {
      "id": 16,
      "plugin": "TriggerFish-Elements",
      "model": "TfProgSequencer",
      "version": "2.5.3",
      "params": [],
      "data": {
        "source": "comp = rhythm {\n  subdiv 16n\n  // Three sixteenths, an upbeat hit, then repeat from beat 3-and.\n  events x_3 x ~!6 x_3 x ~!2\n}\n\nkeys = sequence {\n  subdiv 2n\n  chords (C F A)_2 (C D G)_2 (B, D G)_2 (A, C F) (G, C E)\n  rhythm comp\n  gate .95 .8\n  velocity .72 .8\n}\n\nplay keys\n",
        "languageVersion": 1,
        "editorHeatmap": 2,
        "panelWidthHp": 38
      },
      "pos": [
        72,
        0
      ]
    },
